# ---------------------------------------------------------------------------
# Copy to .env.local for development. Set the same variables in Vercel under
# Project Settings -> Environment Variables for Preview and Production.
#
# Never commit a filled-in .env file. .gitignore already excludes it.
# ---------------------------------------------------------------------------

# Canonical origin. Used for canonical URLs, sitemap.xml, robots.txt and Open
# Graph metadata.
#
# Optional. If unset, blank, or unparseable, the app falls back to the
# Vercel-provided deployment URL and then to site.url in src/data/site.ts.
# A missing scheme, a trailing slash or a path are all normalised away.
#
# Leaving this key out entirely is fine. Do NOT set it to an empty value in
# Vercel expecting the fallback — it is handled, but an explicit domain in
# Production is what you actually want for SEO.
NEXT_PUBLIC_SITE_URL=https://hussainahmad.me

# ---------------------------------------------------------------------------
# Contact form (optional — the form reports a clear error when unconfigured,
# and never silently discards a message)
# ---------------------------------------------------------------------------

# API key from https://resend.com (the free tier is sufficient).
RESEND_API_KEY=

# Verified sender. The domain must be verified in Resend.
# Format: "Name <address@your-domain.com>" or just the address.
RESEND_FROM_EMAIL=

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=
